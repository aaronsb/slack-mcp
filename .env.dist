# .env may set only these two keys. Set every other setting (tokens,
# SSE host, port and key, deployment, and the rest) in your MCP client config.
SLACK_MCP_PERSONALITY="" # Label shown in the server name; ASCII letters, digits, space, _ . - only, max 32
SLACK_MCP_NO_BROWSER="" # Any value: print the setup URL instead of opening a browser
